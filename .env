# ==============================================================
# AI Loan Eligibility Checker & BFSI Platform Configuration
# ==============================================================

FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
SECRET_KEY=bfsi-loan-ai-secret-key-super-secure-2026

# Groq API Configuration (OpenAI-compatible high-speed inference)
# Leave empty to use intelligent built-in financial reasoning engine
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Claude AI (Anthropic) Configuration
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Preferred AI Provider ('groq', 'claude', or 'auto')
AI_PROVIDER=auto

# Google Apps Script Web App Endpoint for Google Sheets Logging
GOOGLE_APPS_SCRIPT_URL=
